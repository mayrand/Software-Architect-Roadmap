{
  "tasks": {
    "start": "deno run --allow-write=out --allow-read=out main.ts",
    "dev": "deno run --watch --allow-write=out --allow-read=out main.ts",
    "test": "deno test --allow-write=out --allow-read=out",
    "check": "deno fmt --check && deno lint && deno check main.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "fmt": {
    "lineWidth": 100
  }
}
